{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["bun-types", "node"],
    "paths": {
      "chimpbase": ["./packages/runtime/index.ts"],
      "chimpbase/auth": ["./packages/auth/src/index.ts"],
      "chimpbase/blobs": ["./packages/blobs/src/index.ts"],
      "chimpbase/core": ["./packages/core/index.ts"],
      "chimpbase/host": ["./packages/host/src/index.ts"],
      "chimpbase/mesh": ["./packages/mesh/src/index.ts"],
      "chimpbase/otel": ["./packages/otel/src/index.ts"],
      "chimpbase/pact": ["./packages/pact/src/index.ts"],
      "chimpbase/postgres": ["./packages/postgres/src/index.ts"],
      "chimpbase/rest-collections": ["./packages/rest-collections/src/index.ts"],
      "chimpbase/runtime": ["./packages/runtime/index.ts"],
      "chimpbase/runtime/bun": ["./packages/bun/src/library.ts"],
      "chimpbase/runtime/bun/cli": ["./packages/bun/src/cli.ts"],
      "chimpbase/runtime/deno": ["./packages/deno/src/library.ts"],
      "chimpbase/runtime/deno/cli": ["./packages/deno/src/cli.ts"],
      "chimpbase/runtime/node": ["./packages/node/src/library.ts"],
      "chimpbase/runtime/node/cli": ["./packages/node/src/cli.ts"],
      "chimpbase/tooling": ["./packages/tooling/src/index.ts"],
      "chimpbase/tooling/app": ["./packages/tooling/src/app.ts"],
      "chimpbase/tooling/cli": ["./packages/tooling/src/cli.ts"],
      "chimpbase/tooling/config": ["./packages/tooling/src/config.ts"],
      "chimpbase/tooling/migrations": ["./packages/tooling/src/migrations.ts"],
      "chimpbase/tooling/modules": ["./packages/tooling/src/modules.ts"],
      "chimpbase/tooling/postgres_docker": ["./packages/tooling/src/postgres_docker.ts"],
      "chimpbase/tooling/schema": ["./packages/tooling/src/schema.ts"],
      "chimpbase/tooling/secrets": ["./packages/tooling/src/secrets.ts"],
      "chimpbase/tooling/workflow_contracts": ["./packages/tooling/src/workflow_contracts.ts"],
      "chimpbase/webhooks": ["./packages/webhooks/src/index.ts"],
      "@chimpbase/core": ["./packages/core/index.ts"],
      "@chimpbase/runtime": ["./packages/runtime/index.ts"],
      "@chimpbase/host": ["./packages/host/src/index.ts"],
      "@chimpbase/host/*": ["./packages/host/src/*"],
      "@chimpbase/bun": ["./packages/bun/src/library.ts"],
      "@chimpbase/deno": ["./packages/deno/src/library.ts"],
      "@chimpbase/node": ["./packages/node/src/library.ts"],
      "@chimpbase/postgres": ["./packages/postgres/src/index.ts"],
      "@chimpbase/rest-collections": ["./packages/rest-collections/src/index.ts"],
      "@chimpbase/tooling": ["./packages/tooling/src/index.ts"],
      "@chimpbase/tooling/*": ["./packages/tooling/src/*"],
      "@chimpbase/pact": ["./packages/pact/src/index.ts"],
      "@chimpbase/auth": ["./packages/auth/src/index.ts"],
      "@chimpbase/blobs": ["./packages/blobs/src/index.ts"],
      "@chimpbase/webhooks": ["./packages/webhooks/src/index.ts"],
      "@chimpbase/otel": ["./packages/otel/src/index.ts"],
      "@chimpbase/mesh": ["./packages/mesh/src/index.ts"]
    }
  },
  "include": [
    "packages/bun/**/*.ts",
    "packages/deno/**/*.ts",
    "packages/host/**/*.ts",
    "packages/node/**/*.ts",
    "packages/postgres/**/*.ts",
    "packages/rest-collections/**/*.ts",
    "packages/tooling/**/*.ts",
    "tests/**/*.ts",
    "packages/core/**/*.ts",
    "packages/runtime/**/*.ts",
    "packages/pact/**/*.ts",
    "packages/auth/**/*.ts",
    "packages/blobs/**/*.ts",
    "packages/webhooks/**/*.ts",
    "packages/otel/**/*.ts",
    "packages/mesh/**/*.ts",
    "examples/**/*.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "examples/deno/**"
  ]
}
