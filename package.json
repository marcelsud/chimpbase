{
  "name": "chimpbase",
  "version": "0.8.0",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "packages/auth/dist",
    "packages/blobs/dist",
    "packages/bun/dist",
    "packages/core/dist",
    "packages/deno/dist",
    "packages/host/dist",
    "packages/mesh/dist",
    "packages/node/dist",
    "packages/otel/dist",
    "packages/pact/dist",
    "packages/postgres/dist",
    "packages/rest-collections/dist",
    "packages/runtime/dist",
    "packages/tooling/dist",
    "packages/webhooks/dist"
  ],
  "bin": {
    "chimpbase": "./packages/bun/dist/src/cli.js",
    "chimpbase-node": "./packages/node/dist/src/cli.js"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "examples/*",
    "examples/bun/*",
    "examples/node/*"
  ],
  "exports": {
    ".": {
      "types": "./packages/runtime/dist/index.d.ts",
      "import": "./packages/runtime/dist/index.js",
      "default": "./packages/runtime/dist/index.js"
    },
    "./auth": {
      "types": "./packages/auth/dist/src/index.d.ts",
      "import": "./packages/auth/dist/src/index.js",
      "default": "./packages/auth/dist/src/index.js"
    },
    "./blobs": {
      "types": "./packages/blobs/dist/src/index.d.ts",
      "import": "./packages/blobs/dist/src/index.js",
      "default": "./packages/blobs/dist/src/index.js"
    },
    "./core": {
      "types": "./packages/core/dist/index.d.ts",
      "import": "./packages/core/dist/index.js",
      "default": "./packages/core/dist/index.js"
    },
    "./host": {
      "types": "./packages/host/dist/src/index.d.ts",
      "import": "./packages/host/dist/src/index.js",
      "default": "./packages/host/dist/src/index.js"
    },
    "./mesh": {
      "types": "./packages/mesh/dist/src/index.d.ts",
      "import": "./packages/mesh/dist/src/index.js",
      "default": "./packages/mesh/dist/src/index.js"
    },
    "./otel": {
      "types": "./packages/otel/dist/src/index.d.ts",
      "import": "./packages/otel/dist/src/index.js",
      "default": "./packages/otel/dist/src/index.js"
    },
    "./pact": {
      "types": "./packages/pact/dist/src/index.d.ts",
      "import": "./packages/pact/dist/src/index.js",
      "default": "./packages/pact/dist/src/index.js"
    },
    "./postgres": {
      "types": "./packages/postgres/dist/src/index.d.ts",
      "import": "./packages/postgres/dist/src/index.js",
      "default": "./packages/postgres/dist/src/index.js"
    },
    "./rest-collections": {
      "types": "./packages/rest-collections/dist/src/index.d.ts",
      "import": "./packages/rest-collections/dist/src/index.js",
      "default": "./packages/rest-collections/dist/src/index.js"
    },
    "./runtime": {
      "types": "./packages/runtime/dist/index.d.ts",
      "import": "./packages/runtime/dist/index.js",
      "default": "./packages/runtime/dist/index.js"
    },
    "./runtime/bun": {
      "types": "./packages/bun/dist/src/library.d.ts",
      "import": "./packages/bun/dist/src/library.js",
      "default": "./packages/bun/dist/src/library.js"
    },
    "./runtime/bun/cli": {
      "types": "./packages/bun/dist/src/cli.d.ts",
      "import": "./packages/bun/dist/src/cli.js",
      "default": "./packages/bun/dist/src/cli.js"
    },
    "./runtime/deno": {
      "types": "./packages/deno/dist/src/library.d.ts",
      "import": "./packages/deno/dist/src/library.js",
      "default": "./packages/deno/dist/src/library.js"
    },
    "./runtime/deno/cli": {
      "types": "./packages/deno/dist/src/cli.d.ts",
      "import": "./packages/deno/dist/src/cli.js",
      "default": "./packages/deno/dist/src/cli.js"
    },
    "./runtime/node": {
      "types": "./packages/node/dist/src/library.d.ts",
      "import": "./packages/node/dist/src/library.js",
      "default": "./packages/node/dist/src/library.js"
    },
    "./runtime/node/cli": {
      "types": "./packages/node/dist/src/cli.d.ts",
      "import": "./packages/node/dist/src/cli.js",
      "default": "./packages/node/dist/src/cli.js"
    },
    "./tooling": {
      "types": "./packages/tooling/dist/src/index.d.ts",
      "import": "./packages/tooling/dist/src/index.js",
      "default": "./packages/tooling/dist/src/index.js"
    },
    "./tooling/app": {
      "types": "./packages/tooling/dist/src/app.d.ts",
      "import": "./packages/tooling/dist/src/app.js",
      "default": "./packages/tooling/dist/src/app.js"
    },
    "./tooling/cli": {
      "types": "./packages/tooling/dist/src/cli.d.ts",
      "import": "./packages/tooling/dist/src/cli.js",
      "default": "./packages/tooling/dist/src/cli.js"
    },
    "./tooling/config": {
      "types": "./packages/tooling/dist/src/config.d.ts",
      "import": "./packages/tooling/dist/src/config.js",
      "default": "./packages/tooling/dist/src/config.js"
    },
    "./tooling/migrations": {
      "types": "./packages/tooling/dist/src/migrations.d.ts",
      "import": "./packages/tooling/dist/src/migrations.js",
      "default": "./packages/tooling/dist/src/migrations.js"
    },
    "./tooling/modules": {
      "types": "./packages/tooling/dist/src/modules.d.ts",
      "import": "./packages/tooling/dist/src/modules.js",
      "default": "./packages/tooling/dist/src/modules.js"
    },
    "./tooling/postgres_docker": {
      "types": "./packages/tooling/dist/src/postgres_docker.d.ts",
      "import": "./packages/tooling/dist/src/postgres_docker.js",
      "default": "./packages/tooling/dist/src/postgres_docker.js"
    },
    "./tooling/schema": {
      "types": "./packages/tooling/dist/src/schema.d.ts",
      "import": "./packages/tooling/dist/src/schema.js",
      "default": "./packages/tooling/dist/src/schema.js"
    },
    "./tooling/secrets": {
      "types": "./packages/tooling/dist/src/secrets.d.ts",
      "import": "./packages/tooling/dist/src/secrets.js",
      "default": "./packages/tooling/dist/src/secrets.js"
    },
    "./tooling/workflow_contracts": {
      "types": "./packages/tooling/dist/src/workflow_contracts.d.ts",
      "import": "./packages/tooling/dist/src/workflow_contracts.js",
      "default": "./packages/tooling/dist/src/workflow_contracts.js"
    },
    "./webhooks": {
      "types": "./packages/webhooks/dist/src/index.d.ts",
      "import": "./packages/webhooks/dist/src/index.js",
      "default": "./packages/webhooks/dist/src/index.js"
    }
  },
  "scripts": {
    "build:publish:packages": "node ./scripts/build-package.mjs --publish runtime core tooling postgres host deno node bun rest-collections otel auth blobs webhooks pact mesh",
    "build:check": "node ./scripts/build-package.mjs --check",
    "ci:check": "bun run modules:check && bun run typecheck && bun run check:any && bun run test && bun run publish:dry-run",
    "check:any": "node ./scripts/check-any.mjs",
    "modules:check": "bun packages/bun/src/cli.ts modules check --project-dir examples/modular-monolith",
    "dev:bun:basic": "bun run --filter @chimpbase/example-bun-basic dev",
    "dev:bun:intermediate": "bun run --filter @chimpbase/example-bun-intermediate dev",
    "dev:bun:advanced": "bun run --filter @chimpbase/example-bun-advanced dev",
    "dev:node:basic": "bun run --filter @chimpbase/example-node-basic dev",
    "dev:node:intermediate": "bun run --filter @chimpbase/example-node-intermediate dev",
    "dev:node:advanced": "bun run --filter @chimpbase/example-node-advanced dev",
    "dev:deno:basic": "cd examples/deno/basic && deno task dev",
    "dev:deno:intermediate": "cd examples/deno/intermediate && deno task dev",
    "dev:deno:advanced": "cd examples/deno/advanced && deno task dev",
    "prepack": "bun run build:publish:packages && bun run smoke:package",
    "publish:dry-run": "npm pack --dry-run",
    "release:check": "bun run ci:check",
    "release:publish": "npm publish",
    "smoke:package": "node ./scripts/smoke-package.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "vitepress build docs && wrangler pages deploy docs/.vitepress/dist --project-name chimpbase-docs",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "./node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.200.0",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.200.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.200.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-logs": "^0.200.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@types/pg": "^8.15.6",
    "kysely": "^0.28.11",
    "typescript": "^5.9.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@chimpbase/host": "workspace:*",
    "@types/node": "^24.6.1",
    "bun-types": "^1.3.14",
    "hono": "^4.12.5",
    "vitepress": "^1.6.4",
    "vue": "3.5.32",
    "@vue/server-renderer": "3.5.32",
    "wrangler": "^4.82.1"
  }
}
